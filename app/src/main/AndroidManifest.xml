<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SwarHands">
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".games.rps.RpsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".games.bullseye.BullseyeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".games.cricket.CricketActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".games.signs.SignActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".games.party.PartyActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>
</manifest>
